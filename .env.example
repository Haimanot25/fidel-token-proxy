# Fidel Token Proxy configuration

# Server
PORT=8080
HOST=0.0.0.0

# Default provider (openai, anthropic, gemini, groq, together, mistral, deepseek, ollama, openrouter, cohere)
DEFAULT_PROVIDER=openai

# Provider credentials (set the ones you use)
OPENAI_API_KEY=sk-your-openai-key
# UPSTREAM_BASE_URL / UPSTREAM_API_KEY are legacy aliases for OpenAI
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# SQLite database path
DB_PATH=./data/fidel.db

# Feature toggles
CACHE_ENABLED=true
NORMALIZE_ENABLED=true
# Aggressive mode: also map Ethiopic numerals/punctuation to ASCII
AGGRESSIVE_NORMALIZE=false

# Cost assumptions for savings estimation (USD per 1K tokens)
INPUT_COST_PER_1K=0.005
OUTPUT_COST_PER_1K=0.015
